#!/bin/sh
# backlog-guard: installed by planning-a-large-project (scripts/backlog.py init --install-hooks).
# Keeps backlog branches, refs/backlog/* and commits that touch .backlog/ off remotes.
remote="$1"
allowed=$(git config --get backlog.allowedRemote)
status=0
is_backlog_ref() {
  case "$1" in refs/heads/backlog/*|refs/backlog/*) return 0 ;; *) return 1 ;; esac
}
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  if is_backlog_ref "$local_ref" || is_backlog_ref "$remote_ref"; then
    if [ -z "$allowed" ] || [ "$remote" != "$allowed" ]; then
      echo "backlog-guard: refusing to push $local_ref to $remote; set backlog.allowedRemote to a private remote to allow it" >&2
      status=1
    fi
  fi
  if [ -n "$(printf '%s' "$remote_sha" | tr -d 0)" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    touched=$(git log --format=%H --full-history -m "$remote_sha..$local_sha" -- ':(top).backlog') || exit 1
  else
    touched=$(git log --format=%H --full-history -m "$local_sha" --not --remotes="$remote" -- ':(top).backlog') || exit 1
  fi
  if [ -n "$touched" ]; then
    echo "backlog-guard: $local_ref contains commits that touch .backlog/; refusing to push to $remote" >&2
    status=1
  fi
done
exit $status
