{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exam_profile.schema.json",
  "title": "exam_profile",
  "type": "object",
  "properties": {
    "profile_version": {
      "type": "string",
      "minLength": 1,
      "description": "Revisão deste perfil de exame específico, independente da versão de seu esquema."
    },
    "context": {
      "type": "object",
      "properties": {
        "exam_key": {
          "type": "string",
          "minLength": 1
        },
        "exam_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "enum": [
            "enem",
            "public_exam",
            "certification",
            "academic",
            "professional",
            "language",
            "other",
            "unknown"
          ]
        },
        "edition_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "exam_key",
        "exam_id",
        "family",
        "edition_version",
        "stage",
        "language",
        "jurisdiction"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "outdated"
      ]
    },
    "organizer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "blueprint_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "formats": {
      "type": "array",
      "items": {
        "enum": [
          "single_choice",
          "multiple_response",
          "true_false",
          "written",
          "oral",
          "listening",
          "practical",
          "lab",
          "other"
        ]
      },
      "uniqueItems": true
    },
    "duration_minutes": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "navigation": {
      "enum": [
        "return_allowed",
        "no_return",
        "section_locked",
        "unknown"
      ]
    },
    "scoring": {
      "type": "object",
      "properties": {
        "model": {
          "enum": [
            "raw",
            "net_points",
            "weighted",
            "rubric",
            "scaled",
            "irt",
            "adaptive",
            "unknown"
          ]
        },
        "correct_points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "incorrect_points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "omitted_points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "minimum": {
                "type": "number"
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "metric_kind": {
                "enum": [
                  "raw_accuracy",
                  "net_points",
                  "rubric_points",
                  "scaled_score",
                  "weighted_average"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "description": "Escala/unidade explícita, por exemplo, percentual de 0 a 100 ou pontos do exame."
              }
            },
            "required": [
              "component",
              "minimum",
              "source_id",
              "metric_kind",
              "unit"
            ],
            "additionalProperties": false
          }
        },
        "annulment_rule": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "component_weights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "component",
              "weight",
              "unit",
              "source_id"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "model",
        "correct_points",
        "incorrect_points",
        "omitted_points",
        "minimum_rules",
        "annulment_rule",
        "source_ids",
        "component_weights"
      ],
      "additionalProperties": false
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "profile_schema_version": {
      "const": "2.0"
    }
  },
  "required": [
    "profile_schema_version",
    "profile_version",
    "context",
    "status",
    "organizer",
    "blueprint_version",
    "source_ids",
    "formats",
    "duration_minutes",
    "navigation",
    "scoring",
    "missing_fields"
  ],
  "additionalProperties": false,
  "$defs": {
    "context": {
      "type": "object",
      "properties": {
        "exam_key": {
          "type": "string",
          "minLength": 1
        },
        "exam_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "enum": [
            "enem",
            "public_exam",
            "certification",
            "academic",
            "professional",
            "language",
            "other",
            "unknown"
          ]
        },
        "edition_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "exam_key",
        "exam_id",
        "family",
        "edition_version",
        "stage",
        "language",
        "jurisdiction"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_ids": {
            "minItems": 1
          },
          "context": {
            "properties": {
              "exam_id": {
                "type": "string",
                "minLength": 1
              },
              "edition_version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
