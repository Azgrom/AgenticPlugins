{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_record.schema.json",
  "title": "evidence_record",
  "type": "object",
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_class": {
      "enum": [
        "EXTERNAL_FACT",
        "METHOD_RULE",
        "HEURISTIC",
        "INFERENCE"
      ]
    },
    "origin": {
      "enum": [
        "measured",
        "user_reported",
        "external",
        "inferred"
      ]
    },
    "confidence": {
      "enum": [
        "verified",
        "strong",
        "provisional",
        "unknown"
      ]
    },
    "stability": {
      "enum": [
        "STATIC",
        "PERIODIC",
        "CURRENT"
      ]
    },
    "source_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "locator": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "basis_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "evidence_id",
    "claim",
    "claim_class",
    "origin",
    "confidence",
    "stability",
    "source_ref",
    "locator",
    "retrieved_at",
    "effective_version",
    "basis_ids",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_class": {
            "const": "EXTERNAL_FACT"
          },
          "confidence": {
            "const": "verified"
          }
        },
        "required": [
          "claim_class",
          "confidence"
        ]
      },
      "then": {
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
